#version 450
#ifdef USE_NONUNIFORM
#extension GL_EXT_nonuniform_qualifier : require
layout(std430,binding=0) readonly buffer Source { vec4 value[]; } sources[2];
#else
layout(std430,binding=0) readonly buffer Source0 { vec4 value0[]; };
layout(std430,binding=2) readonly buffer Source1 { vec4 value1[]; };
#endif
layout(local_size_x=64) in;
layout(std430,binding=1) writeonly buffer Output { vec4 result[]; };
layout(push_constant) uniform Params { uint count; } params;
void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=params.count)return;
#ifdef USE_NONUNIFORM
    result[i]=sources[nonuniformEXT(i&1)].value[i];
#else
    result[i]=(i&1)==0?value0[i]:value1[i];
#endif
}
