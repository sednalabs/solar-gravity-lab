#version 450
#ifdef USE_FP64
#extension GL_ARB_gpu_shader_fp64 : require
#define Real double
#define Vector dvec3
#else
#define Real float
#define Vector vec3
#endif
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Input { vec4 positions[]; };
#ifdef USE_FP64
layout(std430,binding=1) writeonly buffer Output { dvec4 acceleration[]; };
#else
layout(std430,binding=1) writeonly buffer Output { vec4 acceleration[]; };
#endif
layout(push_constant) uniform Params { uint count; } params;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=params.count) return;
    Vector p=Vector(positions[i].xyz), a=Vector(0);
    const Vector sources[3]=Vector[3](Vector(0.5,-0.25,0.125),Vector(-0.75,0.5,-0.25),Vector(0.125,0.75,0.5));
    const Real mu[3]=Real[3](Real(1),Real(0.0625),Real(0.015625));
    for(uint s=0;s<3;s++) {
        Vector d=sources[s]-p;
        Real r2=dot(d,d)+Real(0.0009765625);
        Real inv=Real(1)/sqrt(r2);
        a+=d*(mu[s]*inv*inv*inv);
    }
#ifdef USE_FP64
    acceleration[i]=dvec4(a,0);
#else
    acceleration[i]=vec4(a,0);
#endif
}
