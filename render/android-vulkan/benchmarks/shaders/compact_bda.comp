#version 450
#extension GL_EXT_buffer_reference : require
layout(local_size_x=64) in;
layout(buffer_reference,std430,buffer_reference_align=4) writeonly buffer Output { uint ids[]; };
layout(buffer_reference,std430,buffer_reference_align=4) buffer Counter { uint count; };
layout(push_constant) uniform Params { Output outputIds; Counter outputCount; uint count; } params;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i<params.count && (i*17+13)%7<3) params.outputIds.ids[atomicAdd(params.outputCount.count,1)]=i;
}
