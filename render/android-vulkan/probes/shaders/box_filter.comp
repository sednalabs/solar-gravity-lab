#version 450
#extension GL_QCOM_image_processing : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D sourceImage;
layout(set = 0, binding = 1, std430) writeonly buffer Output { vec4 pixels[]; } outputImage;
void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, uvec2(16u)))) {
        return;
    }
    // 64x64 -> 16x16. Box centres and extents exactly cover 4x4 texel blocks.
    vec2 center = (vec2(pixel) + vec2(0.5)) / 16.0;
    outputImage.pixels[pixel.y * 16u + pixel.x] = textureBoxFilterQCOM(sourceImage, center, vec2(4.0));
}
