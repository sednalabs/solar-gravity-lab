#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D sourceImage;
layout(set = 0, binding = 1, std430) writeonly buffer Output { vec4 pixels[]; } outputImage;
void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, uvec2(16u)))) {
        return;
    }
    vec4 sum = vec4(0.0);
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            sum += texelFetch(sourceImage, ivec2(pixel * 4u) + ivec2(x, y), 0);
        }
    }
    outputImage.pixels[pixel.y * 16u + pixel.x] = sum / 16.0;
}
