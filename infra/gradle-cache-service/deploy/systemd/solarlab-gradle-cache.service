[Unit]
Description=Solar Lab Gradle cache service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/solarlab-gradle-cache.env
WorkingDirectory=%h/mmm/solar-gravity-lab-orchard/main/infra/gradle-cache-service
ExecStart=%h/mmm/solar-gravity-lab-orchard/main/infra/gradle-cache-service/target/release/solarlab-gradle-cache-service
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
