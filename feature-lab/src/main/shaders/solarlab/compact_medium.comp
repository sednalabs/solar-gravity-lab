#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform SceneUniforms {
    vec4 centerRelativeAndMetrics;
    vec4 rightAndSpan;
    vec4 upAndSpan;
    vec4 forwardAndDepth;
    vec4 viewport;
} uScene;

struct CheapPointVertex {
    float x;
    float y;
    float z;
    uint colorArgb;
    float sizePx;
};

layout(set = 0, binding = 1, std430) readonly buffer SourceVertices {
    CheapPointVertex src[];
} uSource;

layout(set = 0, binding = 2, std430) writeonly buffer OutputVertices {
    CheapPointVertex dst[];
} uOutput;

layout(set = 0, binding = 3, std430) buffer DrawCommandBuffer {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} uDraw;

layout(push_constant) uniform PushConstants {
    uint sourceCount;
    uint reserved0;
    uint reserved1;
    uint reserved2;
} uPush;

vec3 cameraRelative(CheapPointVertex vertex) {
    return vec3(vertex.x, vertex.y, vertex.z) - uScene.centerRelativeAndMetrics.xyz;
}

float clipX(vec3 relativeM) {
    return dot(relativeM, uScene.rightAndSpan.xyz) / max(uScene.rightAndSpan.w, 1e-6);
}

float clipY(vec3 relativeM) {
    return dot(relativeM, uScene.upAndSpan.xyz) / max(uScene.upAndSpan.w, 1e-6);
}

float clipDepth(vec3 relativeM) {
    return dot(relativeM, uScene.forwardAndDepth.xyz) / max(uScene.forwardAndDepth.w, 1e-6);
}

bool isInsideExtendedView(vec3 relativeM) {
    float x = clipX(relativeM);
    float y = clipY(relativeM);
    float z = clipDepth(relativeM);
    return abs(x) <= 1.08 && abs(y) <= 1.08 && abs(z) <= 1.10;
}

uint hash32(uvec3 v) {
    uint h = v.x * 1664525u + 1013904223u;
    h ^= v.y * 2246822519u;
    h ^= v.z * 3266489917u;
    h ^= h >> 15;
    h *= 2246822519u;
    h ^= h >> 13;
    h *= 3266489917u;
    h ^= h >> 16;
    return h;
}

uint mediumStrideForZoom(float depthAbs) {
    float zoom = max(uScene.centerRelativeAndMetrics.w / 2.5e8, 1.0);
    uint zoomStride = 1u + uint(clamp(floor(log2(zoom)), 0.0, 4.0));
    uint depthStride = 1u + uint(clamp(floor(depthAbs * 1.5), 0.0, 2.0));
    return max(zoomStride, depthStride);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uPush.sourceCount) {
        return;
    }

    CheapPointVertex candidate = uSource.src[index];
    vec3 relative = cameraRelative(candidate);
    if (!isInsideExtendedView(relative)) {
        return;
    }

    float x = clipX(relative);
    float y = clipY(relative);
    float z = clipDepth(relative);
    uint stride = mediumStrideForZoom(abs(z));

    if (stride > 1u) {
        vec2 uv = vec2(x, -y) * 0.5 + 0.5;
        vec2 clampedUv = clamp(uv, vec2(0.0), vec2(0.999999));
        uvec2 viewportPx = uvec2(max(uScene.viewport.xy, vec2(1.0)));
        uvec2 pixel = uvec2(floor(clampedUv * vec2(viewportPx)));
        uvec2 strideCell = pixel / stride;
        uint depthSlice = uint(clamp(floor((z * 0.5 + 0.5) * 12.0), 0.0, 11.0));
        uint keepHash = hash32(uvec3(strideCell, depthSlice ^ stride ^ (index & 3u)));
        if ((keepHash % stride) != 0u) {
            return;
        }
    }

    candidate.sizePx = min(candidate.sizePx + float(stride - 1u) * 0.18, max(uScene.viewport.z, 1.0));

    uint outputIndex = atomicAdd(uDraw.vertexCount, 1u);
    uOutput.dst[outputIndex] = candidate;
}
