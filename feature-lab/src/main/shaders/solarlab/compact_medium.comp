#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform SceneUniforms {
    vec4 centerSpan;
    vec4 metrics;
    vec4 viewport;
} uScene;

struct MediumTracerState {
    uvec2 handleWords;
    vec2 positionM;
    vec2 velocityMps;
    uint colorArgb;
    float sizePx;
    float trailAlpha;
    float trailReserved;
};

struct CheapPointVertex {
    vec2 positionM;
    uint colorArgb;
    float sizePx;
};

struct AuthoritativeInfluenceBody {
    vec4 positionMass;
};

layout(set = 0, binding = 1, std430) buffer SourceVertices {
    MediumTracerState src[];
} uState;

layout(set = 0, binding = 2, std430) writeonly buffer OutputVertices {
    CheapPointVertex dst[];
} uOutput;

layout(set = 0, binding = 3, std430) buffer DrawCommandBuffer {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} uDraw;

layout(set = 0, binding = 4, std430) readonly buffer InfluenceBodies {
    AuthoritativeInfluenceBody bodies[];
} uInfluence;

layout(push_constant) uniform PushConstants {
    uint sourceCount;
    uint reserved0;
    uint reserved1;
    uint reserved2;
} uPush;

bool isInsideExtendedView(vec2 positionM) {
    vec2 delta = abs(positionM - uScene.centerSpan.xy);
    vec2 span = max(uScene.centerSpan.zw, vec2(1e-6)) * 1.05;
    return all(lessThanEqual(delta, span));
}

uint mediumStrideForZoom() {
    float zoom = max(uScene.metrics.x / 2.5e8, 1.0);
    return 1u + uint(clamp(floor(log2(zoom)), 0.0, 4.0));
}

vec2 accelerationAt(vec2 positionM) {
    const float gravitationalConstant = 6.67430e-11;
    const float softeningSquared = 1.0;
    vec2 acceleration = vec2(0.0);
    uint influenceCount = uint(max(uScene.viewport.w, 0.0));
    for (uint influenceIndex = 0u; influenceIndex < influenceCount; ++influenceIndex) {
        AuthoritativeInfluenceBody influence = uInfluence.bodies[influenceIndex];
        vec2 delta = influence.positionMass.xy - positionM;
        float distanceSquared = max(dot(delta, delta) + softeningSquared, 1.0);
        float inverseDistance = inversesqrt(distanceSquared);
        float inverseDistanceCubed = inverseDistance * inverseDistance * inverseDistance;
        acceleration += delta * (gravitationalConstant * influence.positionMass.w * inverseDistanceCubed);
    }
    return acceleration;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uPush.sourceCount) {
        return;
    }

    MediumTracerState candidate = uState.src[index];
    float stepSeconds = max(uScene.viewport.z, 0.0);
    if (stepSeconds > 0.0) {
        vec2 acceleration0 = accelerationAt(candidate.positionM);
        vec2 velocityHalf = candidate.velocityMps + (acceleration0 * (0.5 * stepSeconds));
        vec2 positionNext = candidate.positionM + (velocityHalf * stepSeconds);
        vec2 acceleration1 = accelerationAt(positionNext);
        candidate.positionM = positionNext;
        candidate.velocityMps = velocityHalf + (acceleration1 * (0.5 * stepSeconds));
    }
    if (!isInsideExtendedView(candidate.positionM)) {
        uState.src[index] = candidate;
        return;
    }

    uint stride = mediumStrideForZoom();
    if (stride > 1u && (index % stride) != 0u) {
        uState.src[index] = candidate;
        return;
    }

    candidate.sizePx = min(candidate.sizePx + float(stride - 1u) * 0.15, max(uScene.metrics.z, 1.0));
    uState.src[index] = candidate;

    uint outputIndex = atomicAdd(uDraw.vertexCount, 1u);
    uOutput.dst[outputIndex] = CheapPointVertex(
        candidate.positionM,
        candidate.colorArgb,
        candidate.sizePx
    );
}
