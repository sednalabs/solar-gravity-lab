#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform SceneUniforms {
    vec4 centerSpan;
    vec4 metrics;
    vec4 viewport;
} uScene;

struct FarTracerState {
    vec2 positionM;
    vec2 velocityMps;
    uint colorArgb;
    uint densityWeight;
    float reserved0;
    float reserved1;
};

struct DensityPointVertex {
    vec2 positionM;
    uint colorArgb;
    uint densityWeight;
};

layout(set = 0, binding = 1, std430) readonly buffer SourceVertices {
    FarTracerState src[];
} uSource;

layout(set = 0, binding = 2, std430) writeonly buffer OutputVertices {
    DensityPointVertex dst[];
} uOutput;

layout(set = 0, binding = 3, std430) buffer DrawCommandBuffer {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} uDraw;

layout(set = 0, binding = 4, std430) buffer TileCounterBuffer {
    uint counts[];
} uTiles;

layout(push_constant) uniform PushConstants {
    uint sourceCount;
    uint reserved0;
    uint reserved1;
    uint reserved2;
} uPush;

bool isInsideExtendedView(vec2 positionM) {
    vec2 delta = abs(positionM - uScene.centerSpan.xy);
    vec2 span = max(uScene.centerSpan.zw, vec2(1e-6)) * 1.08;
    return all(lessThanEqual(delta, span));
}

uint farStrideForZoom(uint densityWeight) {
    float zoom = max(uScene.metrics.x / 5.0e8, 1.0);
    uint zoomStride = 1u + uint(clamp(floor(log2(zoom)), 0.0, 6.0));
    return max(max(densityWeight, 1u), zoomStride);
}

uint farTileCapacity(uint stride) {
    uint clampedStride = clamp(stride, 1u, 8u);
    return max(1u, 8u / clampedStride);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uPush.sourceCount) {
        return;
    }

    FarTracerState candidate = uSource.src[index];
    candidate.positionM += candidate.velocityMps * max(uScene.viewport.z, 0.0);
    if (!isInsideExtendedView(candidate.positionM)) {
        return;
    }

    uint stride = farStrideForZoom(candidate.densityWeight);
    vec2 relative = candidate.positionM - uScene.centerSpan.xy;
    vec2 span = max(uScene.centerSpan.zw, vec2(1e-6));
    vec2 uv = relative / span * 0.5 + 0.5;
    uvec2 viewportPx = max(uvec2(uScene.viewport.xy), uvec2(1u));
    vec2 clampedUv = clamp(uv, vec2(0.0), vec2(0.999999));
    uvec2 pixel = uvec2(floor(clampedUv * vec2(viewportPx)));

    const uint tileShift = 4u; // 16x16 pixel tiles.
    uvec2 tileCoord = pixel >> tileShift;
    uvec2 tileGrid = (viewportPx + ((1u << tileShift) - 1u)) >> tileShift;
    uint tileIndex = tileCoord.x + (tileCoord.y * max(tileGrid.x, 1u));
    uint tileCapacity = farTileCapacity(stride);
    uint slot = atomicAdd(uTiles.counts[tileIndex], 1u);
    if (slot >= tileCapacity) {
        return;
    }

    candidate.densityWeight = max(candidate.densityWeight, stride);

    uint outputIndex = atomicAdd(uDraw.vertexCount, 1u);
    uOutput.dst[outputIndex] = DensityPointVertex(
        candidate.positionM,
        candidate.colorArgb,
        candidate.densityWeight
    );
}
