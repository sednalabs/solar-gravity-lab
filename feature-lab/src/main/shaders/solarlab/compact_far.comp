#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std140) uniform SceneUniforms {
    vec4 centerSpan;
    vec4 metrics;
    vec4 viewport;
} uScene;

struct FarTracerState {
    uvec2 handleWords;
    vec2 positionM;
    vec2 velocityMps;
    uint colorArgb;
    uint densityWeight;
    float trailAlpha;
    float trailReserved;
};

struct DensityPointVertex {
    vec2 positionM;
    uint colorArgb;
    uint densityWeight;
};

struct TrailVertex {
    vec2 positionM;
    uint colorArgb;
    float alpha;
};

struct TrailHistoryMeta {
    uint sampleCount;
    uint capacity;
    uint reserved0;
    uint reserved1;
};

struct AuthoritativeInfluenceBody {
    vec4 positionMass;
};

layout(set = 0, binding = 1, std430) buffer SourceVertices {
    FarTracerState src[];
} uState;

layout(set = 0, binding = 2, std430) writeonly buffer OutputVertices {
    DensityPointVertex dst[];
} uOutput;

layout(set = 0, binding = 3, std430) buffer DrawCommandBuffer {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} uDraw;

layout(set = 0, binding = 4, std430) readonly buffer InfluenceBodies {
    AuthoritativeInfluenceBody bodies[];
} uInfluence;

layout(set = 0, binding = 5, std430) buffer TileCounterBuffer {
    uint counts[];
} uTiles;

layout(set = 0, binding = 6, std430) buffer TrailVertices {
    TrailVertex vertices[];
} uTrails;

layout(set = 0, binding = 7, std430) buffer TrailMetaBuffer {
    TrailHistoryMeta entries[];
} uTrailMeta;

layout(push_constant) uniform PushConstants {
    uint sourceCount;
    uint reserved0;
    uint reserved1;
    uint reserved2;
} uPush;

bool isInsideExtendedView(vec2 positionM) {
    vec2 delta = abs(positionM - uScene.centerSpan.xy);
    vec2 span = max(uScene.centerSpan.zw, vec2(1e-6)) * 1.08;
    return all(lessThanEqual(delta, span));
}

uint farStrideForZoom(uint densityWeight) {
    float zoom = max(uScene.metrics.x / 5.0e8, 1.0);
    uint zoomStride = 1u + uint(clamp(floor(log2(zoom)), 0.0, 6.0));
    return max(max(densityWeight, 1u), zoomStride);
}

uint farTileCapacity(uint stride) {
    uint clampedStride = clamp(stride, 1u, 8u);
    return max(1u, 8u / clampedStride);
}

vec2 accelerationAt(vec2 positionM) {
    const float gravitationalConstant = 6.67430e-11;
    const float softeningSquared = 1.0;
    vec2 acceleration = vec2(0.0);
    uint influenceCount = uint(max(uScene.viewport.w, 0.0));
    for (uint influenceIndex = 0u; influenceIndex < influenceCount; ++influenceIndex) {
        AuthoritativeInfluenceBody influence = uInfluence.bodies[influenceIndex];
        vec2 delta = influence.positionMass.xy - positionM;
        float distanceSquared = max(dot(delta, delta) + softeningSquared, 1.0);
        float inverseDistance = inversesqrt(distanceSquared);
        float inverseDistanceCubed = inverseDistance * inverseDistance * inverseDistance;
        acceleration += delta * (gravitationalConstant * influence.positionMass.w * inverseDistanceCubed);
    }
    return acceleration;
}

void appendTrailSample(uint index, vec2 positionM, uint colorArgb, float alpha) {
    TrailHistoryMeta meta = uTrailMeta.entries[index];
    uint capacity = max(meta.capacity, 1u);
    uint sampleCount = min(meta.sampleCount, capacity);
    uint base = index * capacity;

    if (sampleCount < capacity) {
        sampleCount += 1u;
    }
    if (sampleCount > 1u) {
        for (uint trailIndex = 0u; trailIndex + 1u < sampleCount; ++trailIndex) {
            uTrails.vertices[base + trailIndex] = uTrails.vertices[base + trailIndex + 1u];
        }
    }

    uTrails.vertices[base + sampleCount - 1u] = TrailVertex(positionM, colorArgb, alpha);

    for (uint trailIndex = sampleCount; trailIndex < capacity; ++trailIndex) {
        uTrails.vertices[base + trailIndex] = TrailVertex(positionM, colorArgb, 0.0);
    }
    for (uint trailIndex = 0u; trailIndex < sampleCount; ++trailIndex) {
        float fade = sampleCount <= 1u ? alpha : alpha * float(trailIndex + 1u) / float(sampleCount);
        uTrails.vertices[base + trailIndex].colorArgb = colorArgb;
        uTrails.vertices[base + trailIndex].alpha = fade;
    }

    meta.sampleCount = sampleCount;
    uTrailMeta.entries[index] = meta;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= uPush.sourceCount) {
        return;
    }

    FarTracerState candidate = uState.src[index];
    float stepSeconds = max(uScene.viewport.z, 0.0);
    if (stepSeconds > 0.0) {
        vec2 acceleration0 = accelerationAt(candidate.positionM);
        vec2 velocityHalf = candidate.velocityMps + (acceleration0 * (0.5 * stepSeconds));
        vec2 positionNext = candidate.positionM + (velocityHalf * stepSeconds);
        vec2 acceleration1 = accelerationAt(positionNext);
        candidate.positionM = positionNext;
        candidate.velocityMps = velocityHalf + (acceleration1 * (0.5 * stepSeconds));
        appendTrailSample(index, candidate.positionM, candidate.colorArgb, candidate.trailAlpha);
    }
    if (!isInsideExtendedView(candidate.positionM)) {
        uState.src[index] = candidate;
        return;
    }

    uint stride = farStrideForZoom(candidate.densityWeight);
    vec2 relative = candidate.positionM - uScene.centerSpan.xy;
    vec2 span = max(uScene.centerSpan.zw, vec2(1e-6));
    vec2 uv = relative / span * 0.5 + 0.5;
    uvec2 viewportPx = max(uvec2(uScene.viewport.xy), uvec2(1u));
    vec2 clampedUv = clamp(uv, vec2(0.0), vec2(0.999999));
    uvec2 pixel = uvec2(floor(clampedUv * vec2(viewportPx)));

    const uint tileShift = 4u; // 16x16 pixel tiles.
    uvec2 tileCoord = pixel >> tileShift;
    uvec2 tileGrid = (viewportPx + ((1u << tileShift) - 1u)) >> tileShift;
    uint tileIndex = tileCoord.x + (tileCoord.y * max(tileGrid.x, 1u));
    uint tileCapacity = farTileCapacity(stride);
    uint slot = atomicAdd(uTiles.counts[tileIndex], 1u);
    if (slot >= tileCapacity) {
        uState.src[index] = candidate;
        return;
    }

    candidate.densityWeight = max(candidate.densityWeight, stride);
    uState.src[index] = candidate;

    uint outputIndex = atomicAdd(uDraw.vertexCount, 1u);
    uOutput.dst[outputIndex] = DensityPointVertex(
        candidate.positionM,
        candidate.colorArgb,
        candidate.densityWeight
    );
}
