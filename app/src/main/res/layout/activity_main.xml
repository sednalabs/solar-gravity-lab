<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonStartPause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_start" />

        <Button
            android:id="@+id/buttonStep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_step" />

        <Button
            android:id="@+id/buttonReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_reset" />

        <Button
            android:id="@+id/buttonBackend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_backend_auto" />
    </LinearLayout>

    <TextView
        android:id="@+id/textBackend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="#FF90CAF9"
        android:textSize="12sp"
        tools:text="Backend: Vulkan" />

    <TextView
        android:id="@+id/textDiagnostics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:padding="8dp"
        android:textColor="#CCFFFFFF"
        android:textSize="12sp"
        tools:text="Diagnostics..." />

    <TextView
        android:id="@+id/textControlsHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/controls_hint"
        android:textColor="#88FFFFFF"
        android:textSize="12sp" />

    <com.graciousgazelles.solarlab.feature.lab.render.SolarSystemRenderHostView
        android:id="@+id/renderHost"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
